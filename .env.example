# URL of the Express API (server-side only; the browser calls /api on this origin
# and Next.js proxies it there via rewrites in next.config.ts)
API_URL=http://localhost:5000

# Must be the SAME value as JWT_SECRET in the backend .env.
# Used by proxy.ts to verify the session cookie before rendering protected pages.
JWT_SECRET=replace-with-the-backend-jwt-secret
